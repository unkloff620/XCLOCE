# Copy to .env.local for local development. Never commit real values.

# Postgres connection string (Neon via Vercel Storage in production).
# Leave empty locally to use the built-in in-process PGlite database.
DATABASE_URL=

# Optional: persist the local PGlite database between restarts (folder path).
PGLITE_DIR=.pglite

# Telegram bot token from @BotFather. Required to validate Telegram initData.
TELEGRAM_BOT_TOKEN=

# Optional: secret used to sign session tokens. Defaults to a hash of TELEGRAM_BOT_TOKEN / DATABASE_URL.
SESSION_SECRET=

# Browser "guest" mode for testing outside Telegram. Set to false to require Telegram.
ALLOW_GUEST=true

# Public bot username (without @), used to build referral links.
NEXT_PUBLIC_BOT_USERNAME=

# Max pooled DB connections per serverless instance.
DB_POOL_MAX=5
