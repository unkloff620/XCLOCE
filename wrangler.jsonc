// Cloudflare Workers config (built with OpenNext: npm run cf:build). Secrets are set in the Cloudflare dashboard,
// never here: DATABASE_URL, TELEGRAM_BOT_TOKEN, SESSION_SECRET, CRON_SECRET, ADMIN_TELEGRAM_IDS.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "xcloce",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "xcloce" }],
  // Run the Worker next to the database (Neon), not next to the player: the API makes many queries per request.
  "placement": { "mode": "smart" },
  "observability": { "enabled": true },
  // Telegram reminders every 5 minutes (replaces Vercel Cron and the GitHub Actions pinger).
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": {
    "APP_ENV": "production",
    "ALLOW_GUEST": "false",
    "DB_POOL_MAX": "3"
  }
}
